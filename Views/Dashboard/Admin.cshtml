@model AquaDetect.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<main class="container-fluid p-4">

    <h2 class="fw-bold mb-4">Admin dashboard</h2>

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-secondary mb-1">Open reports</p>
                    <h2 class="fw-bold">@Model.OpenReports</h2>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-secondary mb-1">Critical</p>
                    <h2 class="fw-bold">@Model.CriticalReports</h2>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-secondary mb-1">Duplicates to review</p>
                    <h2 class="fw-bold">@Model.DuplicatesToReview</h2>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <p class="text-secondary mb-1">Resolved this week</p>
                    <h2 class="fw-bold">@Model.ResolvedReports</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Highest priority reports</h5>

                <a href="#" class="btn btn-outline-secondary btn-sm">
                    View all reports
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Location</th>
                            <th>Severity</th>
                            <th>Duplicates</th>
                            <th>Status</th>
                            <th>Age</th>
                        </tr>
                    </thead>

                    <tbody>

                      @if (Model.Reports.Any())
                        {
                            @foreach (var report in Model.Reports)
                            {
                                <tr>
                                    <td>@report.ReportCode</td>
                                    <td>@report.Location</td>
                                    <td>@report.Severity</td>
                                    <td>@report.DuplicateCount</td>
                                    <td>@report.Status</td>
                                    <td>
                                        @{
                                            var age = DateTime.Now - report.CreatedAt;
                                        }

                                        @if (age.TotalDays >= 1)
                                        {
                                            @($"{(int)age.TotalDays} d")
                                        }
                                        else
                                        {
                                            @($"{(int)age.TotalHours} h")
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No reports available.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</main>
